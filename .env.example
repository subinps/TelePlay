# ============================================================================
# Hearth / TelePlay — Backend Environment Template (Neon PostgreSQL)
# ============================================================================
# HOW THIS FILE IS USED
#   * Local development: copy to `backend/.env` — pydantic-settings loads .env
#     from the process working directory, i.e. the `backend/` folder.
#   * Production: the systemd unit uses EnvironmentFile=/etc/hearth/hearth.env
#     (see task T13). This template is the reference for that file.
#   * Cloudflare Pages receives ONLY this build-time variable:
#         VITE_API_URL=https://YOUR-API.duckdns.org/api
#     NEVER put secrets in VITE_* variables — everything in a Vite bundle is
#     public. All other variables below are backend-only.
#
# FAIL FAST BY DESIGN
#   Every placeholder below is intentionally rejected by the validators in
#   backend/app/config.py. Copying this file unchanged and booting MUST fail —
#   that proves you actually replaced the values. Replace every "change-me".
# ============================================================================

# -------------------------------------------
# TELEGRAM (required)
# -------------------------------------------
# Get API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=change-me
TELEGRAM_API_HASH=change-me

# Create a bot via @BotFather and get the token (format: 123456789:AA...)
TELEGRAM_BOT_TOKEN=change-me

# Private storage channel ID (starts with -100). Add the bot as admin, then
# forward a channel post to @userinfobot to read it. Example: -1001234567890
TELEGRAM_STORAGE_CHANNEL_ID=change-me

# REQUIRED. Comma-separated Telegram user IDs allowed to log in.
# The FIRST id is the owner/admin. Empty = the bot denies EVERYONE (fail-closed).
AUTH_USERS=

# Optional helper bot tokens (comma-separated), each added as admin to the
# storage channel. Leave empty until upload/download throughput is measured.
TELEGRAM_HELPER_BOT_TOKENS=

# -------------------------------------------
# SECURITY (required)
# -------------------------------------------
# JWT signing secret, min 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# -------------------------------------------
# DATABASE (required — Neon PostgreSQL only)
# -------------------------------------------
# Async SQLAlchemy URL for Neon. Create an endpoint in the Neon console; the
# pooled host ends in "-pooler.<region>.aws.neon.tech". sslmode=require is
# mandatory. SQLite is NOT supported in production.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@EP-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# -------------------------------------------
# WEB FRONTEND (required)
# -------------------------------------------
# Public origin of the Cloudflare Pages deployment (bare origin, no path).
WEB_BASE_URL=https://YOUR-APP.pages.dev

# Exact CORS origin(s), comma-separated. '*' is rejected. Must match the
# frontend origin above (plus any additional deployed origins).
CORS_ORIGINS=https://YOUR-APP.pages.dev

# -------------------------------------------
# SERVER (optional — defaults shown)
# -------------------------------------------
# Production binds loopback behind Caddy; local dev may override to 0.0.0.0.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO

# -------------------------------------------
# OPTIONAL TUNABLES (defaults shown — leave unset to keep them)
# -------------------------------------------
# JWT_EXPIRY_MINUTES=10080              # access token lifetime (5..43200)
# REFRESH_TOKEN_DAYS=90                 # refresh token lifetime (1..365)
# STREAM_TOKEN_HOURS=12                 # stream URL token lifetime (1..72)
# GUEST_PIN_HOURS=24                    # guest PIN validity (1..168)
# LOGIN_ATTEMPT_LIMIT=5                 # attempts per device per window (1..100)
# LOGIN_ATTEMPT_WINDOW_SECONDS=3600     # lockout window (60..86400)
# MAX_PLAYBACK_DEVICES=2                # concurrent streams per user (1..10)
# PLAYBACK_HEARTBEAT_SECONDS=20         # client heartbeat interval (5..120)
# PLAYBACK_SESSION_TTL_SECONDS=75       # session expiry; > heartbeat (20..600)
# TELEGRAM_SESSION_DIR=                 # default: backend/session/ (must persist across restarts; chmod 700; never commit)
